# ==========================================================
# Plantilla de variables de entorno de InvenShop.
# Copiar este archivo como ".env" y completar los valores.
# El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# ==========================================================

# Clave secreta de Django. Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# True solo en desarrollo. En producción: False (oculta errores sensibles)
DEBUG=True

# Hosts permitidos separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: "sqlite" (por defecto) o "postgresql"
DB_ENGINE=sqlite
# Solo si DB_ENGINE=postgresql:
DB_NAME=invenshop
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# True: Django muestra las imágenes de productos (media/) con runserver.
# Poner False solo en un servidor real donde las sirva Nginx/Apache.
SERVIR_MEDIA=True

# True si el sitio se sirve por HTTPS (activa cookies seguras)
HTTPS=False
